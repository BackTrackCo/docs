direction: right

title: Payment Schemes Comparison {
  near: top-center
  shape: text
  style.font-size: 24
  style.bold: true
}

# Exact Payment (Left Side)
exact_label: EXACT Payment - Immediate Settlement {
  shape: text
  style.font-size: 18
  style.bold: true
  style.font-color: "#4f46e5"
}

exact_client: Client {
  style.fill: "#4f46e5"
  style.stroke: "#4338ca"
  style.font-color: "#ffffff"
}

exact_server: Server {
  style.fill: "#8b5cf6"
  style.stroke: "#7c3aed"
  style.font-color: "#ffffff"
}

exact_receiver: Receiver {
  style.fill: "#10b981"
  style.stroke: "#059669"
  style.font-color: "#ffffff"
}

exact_client -> exact_server: 1. Payment + Signature
exact_server -> exact_receiver: 2. Immediate Transfer
exact_server -> exact_client: 3. Deliver Resource

exact_warning: ⚠️ No recourse after payment\nPayment is final {
  shape: text
  style.font-size: 12
  style.font-color: "#92400e"
}

# Escrow Payment (Right Side)
escrow_label: ESCROW Payment - Deferred Settlement {
  shape: text
  style.font-size: 18
  style.bold: true
  style.font-color: "#f59e0b"
}

escrow_client: Client {
  style.fill: "#4f46e5"
  style.stroke: "#4338ca"
  style.font-color: "#ffffff"
}

escrow_escrow: Escrow Contract\nHolds Funds {
  style.fill: "#f59e0b"
  style.stroke: "#d97706"
  style.font-color: "#ffffff"
}

escrow_operator: Operator\nRelease Logic {
  style.fill: "#ec4899"
  style.stroke: "#db2777"
  style.font-color: "#ffffff"
}

escrow_server: Server {
  style.fill: "#8b5cf6"
  style.stroke: "#7c3aed"
  style.font-color: "#ffffff"
}

escrow_receiver: Receiver {
  style.fill: "#10b981"
  style.stroke: "#059669"
  style.font-color: "#ffffff"
}

escrow_client -> escrow_escrow: 1. Authorize\nLock funds
escrow_server -> escrow_client: 2. Deliver\nResource
escrow_escrow -> escrow_operator: 3. Hold until\nconditions met {
  style.stroke-dash: 3
}
escrow_operator -> escrow_escrow: 4. release()
escrow_escrow -> escrow_receiver: 5. Transfer\nfunds

escrow_escrow -> escrow_client: Alt: Reclaim\nafter expiry {
  style.stroke-dash: 3
  style.stroke: "#9ca3af"
}

escrow_protection: ✓ Protected until conditions met\nFunds held safely, refundable {
  shape: text
  style.font-size: 12
  style.font-color: "#065f46"
}
