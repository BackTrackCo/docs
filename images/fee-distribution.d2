direction: down

title: Fee Distribution Example - 1000 USDC Payment (Additive Model) {
  near: top-center
  shape: text
  style: {
    font-size: 24
    bold: true
  }
}

payment: Payment\n1000 USDC {
  style: {
    fill: "#4f46e5"
    stroke: "#4338ca"
    font-color: "#ffffff"
    bold: true
  }
}

total_fee: Total Fee\n0.50 USDC (5 bps) {
  style: {
    fill: "#8b5cf6"
    stroke: "#7c3aed"
    font-color: "#ffffff"
    bold: true
  }
}

receiver: Receiver Gets\n999.50 USDC {
  style: {
    fill: "#10b981"
    stroke: "#059669"
    font-color: "#ffffff"
    bold: true
  }
}

protocol_fee: Protocol Fee\n0.30 USDC (3 bps)\nvia ProtocolFeeConfig {
  style: {
    fill: "#f59e0b"
    stroke: "#d97706"
    font-color: "#ffffff"
    bold: true
  }
}

operator_fee: Operator Fee\n0.20 USDC (2 bps)\nvia FEE_CALCULATOR {
  style: {
    fill: "#f59e0b"
    stroke: "#d97706"
    font-color: "#ffffff"
    bold: true
  }
}

protocol_treasury: protocolFeeRecipient\n(on ProtocolFeeConfig) {
  style: {
    fill: "#e5e7eb"
    stroke: "#9ca3af"
    font-color: "#374151"
    bold: true
  }
}

fee_recipient: FEE_RECIPIENT\n(on Operator) {
  style: {
    fill: "#e5e7eb"
    stroke: "#9ca3af"
    font-color: "#374151"
    bold: true
  }
}

payment -> total_fee: splits into
payment -> receiver
total_fee -> protocol_fee: +
total_fee -> operator_fee: +
protocol_fee -> protocol_treasury
operator_fee -> fee_recipient
